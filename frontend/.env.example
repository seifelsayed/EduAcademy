# Base URL for API calls.
# Leave as-is in development: Vite proxies /api to http://127.0.0.1:8000,
# which keeps the browser same-origin so Sanctum's cookie auth works.
# In production, point this at the deployed API, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

VITE_APP_NAME="Education Platform"
VITE_CURRENCY=USD
